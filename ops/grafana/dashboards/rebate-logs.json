{
  "title": "Rebate Bot — Logs",
  "schemaVersion": 39,
  "editable": true,
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "svc",
        "type": "custom",
        "query": "rebate-bot,rebate-executor,rebate-accrual",
        "current": { "text": "All", "value": "$__all" },
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Log volume by service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki" },
      "targets": [
        { "refId": "A", "expr": "sum by (service) (count_over_time({job=\"rebate-bot\", service=~\"$svc\"}[5m]))" }
      ]
    },
    {
      "id": 2,
      "title": "Payout events",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "loki" },
      "targets": [
        { "refId": "A", "expr": "{job=\"rebate-bot\", service=~\"$svc\"} |~ \"payout (broadcast sent|confirmed & paid|failed)\"" }
      ]
    },
    {
      "id": 3,
      "title": "Errors & warnings",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "loki" },
      "targets": [
        { "refId": "A", "expr": "{job=\"rebate-bot\", service=~\"$svc\"} | json | level=~\"error|warning\"" }
      ]
    }
  ]
}
