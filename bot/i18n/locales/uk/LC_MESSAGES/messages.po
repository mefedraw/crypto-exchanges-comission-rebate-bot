msgid "Сначала откройте личный кабинет через /start."
msgstr "Спочатку відкрийте кабінет через /start."

msgid "Реферальная программа для этого аккаунта недоступна."
msgstr "Реферальна програма для цього акаунта недоступна."

msgid "Выберите язык / Choose language"
msgstr "Виберіть мову / Choose language"

msgid "Язык сохранен."
msgstr "Мову збережено."

msgid "Язык / Language"
msgstr "Мова / Language"

msgid "Код должен содержать от 5 до 32 латинских букв, цифр, символов _ или -."
msgstr "Код має містити 5–32 латинські літери, цифри, _ або -."

msgid "Этот код зарезервирован. Пожалуйста, выберите другой."
msgstr "Цей код зарезервовано. Виберіть інший."

