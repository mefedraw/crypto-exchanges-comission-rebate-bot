msgstr "UID chỉ được chứa chữ Latin và số."

msgid "Отправлено"
msgstr "Đã gửi"

msgid "Открыт кейс"
msgstr "Đã mở yêu cầu"

msgid "Требуется ответ"
msgstr "Cần trả lời"

msgid "Кейс закрыт"
msgstr "Đã đóng yêu cầu"

msgid "20% · для китов индивидуальные условия"
msgstr "20% · điều kiện riêng cho người dùng khối lượng lớn"

msgid "бонус 12% для команды каждую неделю + 3% к поинтам на TGE"
msgstr "thưởng nhóm 12% mỗi tuần + thưởng điểm 3% tại TGE"

msgid "7% · для китов индивидуальные условия"
msgstr "7% · điều kiện riêng cho người dùng khối lượng lớn"

msgid "Не удалось создать ссылку. Пожалуйста, попробуйте позже."
msgstr "Không thể tạo liên kết. Hãy thử lại sau."

msgid "Сначала откройте личный кабинет через /start."
msgstr "Trước tiên mở tài khoản bằng /start."

msgid "Реферальная программа для этого аккаунта недоступна."
msgstr "Chương trình giới thiệu không khả dụng cho tài khoản này."

msgid "Выберите язык / Choose language"
msgstr "Chọn ngôn ngữ / Choose language"

msgid "Язык сохранен."
msgstr "Đã lưu ngôn ngữ."

msgid "Язык / Language"
msgstr "Ngôn ngữ / Language"

msgid "Код должен содержать от 5 до 32 латинских букв, цифр, символов _ или -."
msgstr "Mã cần có 5–32 chữ Latin, chữ số, _ hoặc -."

msgid "Этот код зарезервирован. Пожалуйста, выберите другой."
msgstr "Mã này được dành riêng. Vui lòng chọn mã khác."

