# Copy to `.env` and fill in. NEVER commit the real `.env`.
# In production, inject these via docker secrets / systemd EnvironmentFile (chmod 600).

# ---- Telegram (roles) ----
BOT_TOKEN=
# DEPRECATED: the bot is OPEN to everyone; this no longer gates access. Optional,
# kept only for backward compatibility — leave empty on new deployments.
USER_TELEGRAM_IDS=
# The developer who RECEIVES alerts (and may also use the bot). Exempt from blocks.
DEVELOPER_TELEGRAM_ID=123456789
# Admins (role granted on first contact); comma-separated. Gate the /admin panel
# and are exempt from blocks. These are the ONLY privileged IDs — access is open;
# turn a specific abuser away with the in-bot admin "block" (users.status=blocked).
ADMIN_TELEGRAM_IDS=123456789

# ---- Demo ----
# When true, all exchanges return fake data so you can test the UX without keys.
# NEVER enable in production.
DEMO_MODE=false

# ---- Secret encryption ----
# Fernet master key used to decrypt the exchange secrets below.
# Generate once with: python -m bot.security.secrets keygen
# Supply only at runtime via env; never write it to disk inside the repo.
MASTER_KEY=

# ---- Admin-initiated affiliate API credential rotation ----
# Disabled by default. Requires MASTER_KEY and the credential-updater Compose
# profile. Only ADMIN_TELEGRAM_IDS may use /api_keys; no TOTP/PIN is requested.
CREDENTIAL_UPDATE_ENABLED=false
CREDENTIAL_UPDATER_SOCKET=/run/rebate-bot/credential-updater.sock
CREDENTIAL_UPDATER_TIMEOUT_SECONDS=10
# The encrypted file is fixed at /etc/rebate-bot/exchange-keys.env (root:root 0600).
# The helper may recreate only the fixed bot,accrual service allowlist.

# ---- Database ----
# POSTGRES_PASSWORD is used by docker-compose for the postgres service AND to build
# DATABASE_URL (compose points it at the `postgres` service). Running a process WITHOUT
# compose? Set DATABASE_URL yourself: postgresql+asyncpg://bot:pass@localhost:5432/bot
POSTGRES_PASSWORD=change-me-strong-password

# ---- Accrual / payout policy ----
REBATE_EPOCH=2026-07-10          # program start; no rebate counted before this date
ACCRUAL_INTERVAL_SECONDS=21600   # accrual cycle cadence; 21600 = every 6h (4x/day). Default 86400 (daily)
AUTO_LIMIT_USDT=200              # payouts over this -> pending_admin (admin release)
CONFIRMATIONS=15                 # BSC confirmations before a sent payout -> paid

# ---- Payout wallet & chain (payout-executor process only) ----
# Generate a wallet (run it yourself; keep the key secret):
#   ./.venv/Scripts/python.exe -c "from eth_account import Account; a=Account.create(); print(a.address); print('0x'+a.key.hex())"
PAYOUT_WALLET_ADDRESS=           # public; optional (derived from the key if omitted)
PAYOUT_PRIVATE_KEY=              # SECRET — executor process only; keep a tiny balance
BSC_RPC_URLS=https://bsc-dataseed.binance.org/   # comma-separated; add a keyed provider for reliability
USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955  # BEP20 USDT on BSC (18 decimals) — VERIFY on bscscan
BSC_CHAIN_ID=56                  # 56 = BSC mainnet, 97 = BSC testnet
MAX_GAS_PRICE_WEI=               # optional fail-closed gas ceiling (wei); empty = no cap

# ---- Mantle RPC & MNT payouts (payout-executor process only) ----
# MNT is the native coin on Mantle (no contract/decimals to configure — unlike the
# BEP20 USDT above). Leaving MANTLE_RPC_URL empty disables MNT payouts entirely
# (they fail closed as `mnt_disabled`); everything else in the bot is unaffected.
# HTTP(S) RPC only (the client uses an HTTP provider — a wss:// URL will NOT work).
# Verified working: https://mantle-public.nodies.app or https://mantle-rpc.publicnode.com
MANTLE_RPC_URL=                  # empty = MNT payouts disabled
MANTLE_CHAIN_ID=5000             # 5000 = Mantle mainnet, 5003 = Mantle Sepolia testnet
# Fail-closed gas ceiling (wei) for Mantle specifically — NOT the BSC MAX_GAS_PRICE_WEI
# above. Mantle's baseline eth_gasPrice sits ~50 gwei, so the built-in default is 2000
# gwei (still ~0.04 MNT / a few cents for a native transfer). Leave commented to keep it;
# an explicit empty value here means no cap at all.
# MANTLE_MAX_GAS_PRICE_WEI=

# ---- Deploy/SSH (used by your deploy tooling, NOT read by the app) ----
# Prefer an SSH key over a password (security §9: key-only, password login disabled).
# IP=your.server.ip
# USER=deploy
# PASS=

# ---- Exchange API credentials ----
# Values may be either plaintext (basic mode) or Fernet tokens (encrypted mode);
# encrypted mode is enabled automatically when MASTER_KEY is set.
# Prepare encrypted values with: python -m bot.security.secrets encrypt
#
# Leave an exchange blank to skip it — the adapter will not be registered.
#
# SECURITY: create every key with affiliate/read scope ONLY.
# NEVER grant trade or withdraw permissions. Bybit: "Affiliate" permission only.
# Bind keys to the VPS IP where the exchange supports IP whitelisting.

BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

BITMART_API_KEY=
# Optional; current futures affiliate KEYED endpoints use X-BM-KEY only.
BITMART_API_SECRET=

BYBIT_API_KEY=
BYBIT_API_SECRET=

WEEX_API_KEY=
WEEX_API_SECRET=
WEEX_API_PASSPHRASE=

GATE_API_KEY=
GATE_API_SECRET=

OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=

MEXC_API_KEY=
MEXC_API_SECRET=

# Toobit affiliate ("agent") API — key+secret, no passphrase. Needs affiliate access.
TOOBIT_API_KEY=
TOOBIT_API_SECRET=

# Binance apiReferral (Api-Agent / API Partner) — key+secret, no passphrase.
# ONLY works if the account is enrolled as an Api-Agent; a plain affiliate referral
# link has NO API access. Key needs "Enable Reading" only (no trade/withdraw).
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# ---- Log shipping (Fluent Bit -> Grafana Cloud Loki) ----
# Grafana Cloud -> Connections -> Loki: copy the host (WITHOUT https:// and WITHOUT the
# /loki/... path) and the numeric user/instance id. Create an Access Policy token scoped
# to `logs:write` only. Enable 2FA on the Grafana Cloud account. Never commit real values.
GRAFANA_LOKI_HOST=logs-prod-000.grafana.net
GRAFANA_LOKI_USER=000000
GRAFANA_LOKI_TOKEN=glc_replace_me
