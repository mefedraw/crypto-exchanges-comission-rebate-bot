# syntax=docker/dockerfile:1

# The updater intentionally uses only the Python standard library plus the
# Docker CLI. It never imports or runs the Telegram bot.
FROM docker:27.3.1-cli

RUN apk add --no-cache python3

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY bot/security/credential_updater.py ./credential_updater.py

ENTRYPOINT ["python3", "/app/credential_updater.py"]
